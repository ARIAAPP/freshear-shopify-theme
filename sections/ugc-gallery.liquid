{%- comment -%}
  UGC Gallery — "Ils l'ont adopté"
  Galerie lifestyle de photos clients (UGC style) pour rassurer les visiteurs.
  Updated: 2026-06-08
  Carrousel horizontal sur mobile, grille masonry-like sur desktop.
  v1.1
{%- endcomment -%}

<section class="ugc-gallery-section" id="ugc-gallery">
  <div class="ugc-gallery__container">
    <div class="ugc-gallery__header">
      <p class="ugc-gallery__eyebrow">{{ section.settings.eyebrow }}</p>
      <h2 class="ugc-gallery__title">{{ section.settings.title }}</h2>
      <p class="ugc-gallery__subtitle">{{ section.settings.subtitle }}</p>
    </div>

    <div class="ugc-gallery__track" data-ugc-track>
      {%- for block in section.blocks -%}
        <div class="ugc-gallery__item {{ block.settings.size }}" {{ block.shopify_attributes }}>
          <div class="ugc-gallery__img-wrap">
            {%- if block.settings.image != blank -%}
              <img
                src="{{ block.settings.image | image_url: width: 600 }}"
                alt="{{ block.settings.caption | default: shop.name }}"
                width="400"
                height="500"
                loading="lazy"
                decoding="async"
                class="ugc-gallery__img"
              >
            {%- elsif block.settings.asset_filename != blank -%}
              <img
                src="{{ block.settings.asset_filename | asset_url }}"
                alt="{{ block.settings.caption | default: shop.name }}"
                width="400"
                height="500"
                loading="lazy"
                decoding="async"
                class="ugc-gallery__img"
              >
            {%- endif -%}
            {%- if block.settings.caption != blank -%}
              <div class="ugc-gallery__caption">
                <span class="ugc-gallery__caption-text">{{ block.settings.caption }}</span>
              </div>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>

    {%- if section.settings.show_cta -%}
      <div class="ugc-gallery__cta-wrap">
        <a href="{{ section.settings.cta_url | default: '/#product' }}" class="ugc-gallery__cta">
          {{ section.settings.cta_label | default: 'Rejoignez-les' }}
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

<style>
  .ugc-gallery-section {
    padding: 4rem 0;
    background: var(--color-bg);
    overflow: hidden;
  }
  .ugc-gallery__container {
    max-width: var(--container-max, 1200px);
    margin: 0 auto;
    padding: 0 1rem;
  }
  .ugc-gallery__header {
    text-align: center;
    margin-bottom: 2.5rem;
  }
  .ugc-gallery__eyebrow {
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-primary);
    margin-bottom: 0.5rem;
  }
  .ugc-gallery__title {
    font-size: 2rem;
    font-weight: 800;
    color: var(--color-fg);
    margin: 0 0 0.5rem;
    line-height: 1.2;
  }
  .ugc-gallery__subtitle {
    font-size: 0.95rem;
    color: var(--color-muted-fg);
    max-width: 500px;
    margin: 0 auto;
  }

  /* Desktop: grid masonry-like */
  .ugc-gallery__track {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.75rem;
    align-items: start;
  }
  .ugc-gallery__item {
    border-radius: var(--radius, 12px);
    overflow: hidden;
    position: relative;
  }
  .ugc-gallery__item.tall {
    grid-row: span 2;
  }
  .ugc-gallery__img-wrap {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius, 12px);
  }
  .ugc-gallery__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
    min-height: 200px;
  }
  .ugc-gallery__item.tall .ugc-gallery__img {
    min-height: 420px;
  }
  .ugc-gallery__img-wrap:hover .ugc-gallery__img {
    transform: scale(1.03);
  }
  .ugc-gallery__caption {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 0.6rem 0.8rem;
    background: linear-gradient(transparent, rgba(0,0,0,0.65));
    pointer-events: none;
  }
  .ugc-gallery__caption-text {
    color: #fff;
    font-size: 0.78rem;
    font-weight: 500;
    line-height: 1.3;
  }

  .ugc-gallery__cta-wrap {
    text-align: center;
    margin-top: 2rem;
  }
  .ugc-gallery__cta {
    display: inline-block;
    padding: 0.85rem 2.5rem;
    background: var(--color-primary);
    color: var(--color-primary-fg);
    font-weight: 700;
    font-size: 0.95rem;
    border-radius: var(--radius, 12px);
    text-decoration: none;
    transition: opacity 0.2s;
  }
  .ugc-gallery__cta:hover {
    opacity: 0.9;
  }

  /* Mobile: horizontal scroll */
  @media (max-width: 768px) {
    .ugc-gallery-section {
      padding: 3rem 0;
    }
    .ugc-gallery__title {
      font-size: 1.5rem;
    }
    .ugc-gallery__track {
      display: flex;
      gap: 0.75rem;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      padding: 0 1rem 0.5rem;
      scrollbar-width: none;
    }
    .ugc-gallery__track::-webkit-scrollbar {
      display: none;
    }
    .ugc-gallery__item {
      flex: 0 0 70vw;
      max-width: 280px;
      scroll-snap-align: start;
    }
    .ugc-gallery__item.tall {
      grid-row: unset;
    }
    .ugc-gallery__img {
      min-height: 320px !important;
      max-height: 400px;
    }
  }
</style>

{% schema %}
{
  "name": "Galerie UGC",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Sur-titre",
      "default": "Photos clients"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Titre",
      "default": "Ils l'ont adopté"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Sous-titre",
      "default": "De vraies photos de nos clients au quotidien"
    },
    {
      "type": "checkbox",
      "id": "show_cta",
      "label": "Afficher le bouton CTA",
      "default": true
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Texte du CTA",
      "default": "Rejoignez-les"
    },
    {
      "type": "text",
      "id": "cta_url",
      "label": "Lien du CTA",
      "default": "/#product"
    }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "Photo UGC",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image (upload)"
        },
        {
          "type": "text",
          "id": "asset_filename",
          "label": "Ou nom fichier asset (ex: ugc-photo.jpg)"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Légende (optionnel)"
        },
        {
          "type": "select",
          "id": "size",
          "label": "Taille",
          "options": [
            { "value": "normal", "label": "Normal" },
            { "value": "tall", "label": "Grand (2 lignes)" }
          ],
          "default": "normal"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Galerie UGC"
    }
  ]
}
{% endschema %}
