[
  {
    "name": "theme_info",
    "theme_name": "FreshEar",
    "theme_version": "1.0.0",
    "theme_author": "FreshEar Co",
    "theme_documentation_url": "https://freshearco.com",
    "theme_support_url": "https://freshearco.com"
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "header",
        "content": "Brand"
      },
      {
        "type": "color",
        "id": "color_primary",
        "label": "Primary color (teal)",
        "default": "#4ECDC4"
      },
      {
        "type": "color",
        "id": "color_primary_foreground",
        "label": "Text on primary",
        "default": "#ffffff"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Accent color (promo red)",
        "default": "#dc2626"
      },
      {
        "type": "color",
        "id": "color_accent_foreground",
        "label": "Text on accent",
        "default": "#ffffff"
      },
      {
        "type": "header",
        "content": "Background and text"
      },
      {
        "type": "color",
        "id": "color_background",
        "label": "Background",
        "default": "#ffffff"
      },
      {
        "type": "color",
        "id": "color_foreground",
        "label": "Text",
        "default": "#121212"
      },
      {
        "type": "color",
        "id": "color_muted",
        "label": "Secondary background",
        "default": "#f3f4f5"
      },
      {
        "type": "color",
        "id": "color_muted_foreground",
        "label": "Secondary text",
        "default": "#737373"
      },
      {
        "type": "color",
        "id": "color_border",
        "label": "Border",
        "default": "#e5e5e5"
      },
      {
        "type": "header",
        "content": "Footer"
      },
      {
        "type": "color",
        "id": "color_footer_bg",
        "label": "Footer background",
        "default": "#121212"
      },
      {
        "type": "color",
        "id": "color_footer_fg",
        "label": "Footer text",
        "default": "#e5e5e5"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "select",
        "id": "font_family",
        "label": "Font",
        "default": "poppins",
        "options": [
          { "value": "poppins", "label": "Poppins" },
          { "value": "inter", "label": "Inter" },
          { "value": "system", "label": "System font" }
        ]
      }
    ]
  },
  {
    "name": "Logo & Identity",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo (optional — if empty, styled text)"
      },
      {
        "type": "range",
        "id": "logo_max_width",
        "label": "Max logo width",
        "min": 80,
        "max": 280,
        "step": 10,
        "unit": "px",
        "default": 140
      },
      {
        "type": "text",
        "id": "brand_text",
        "label": "Brand name (if no logo)",
        "default": "FreshEar Co"
      },
      {
        "type": "text",
        "id": "brand_text_highlight",
        "label": "Word to color with primary",
        "info": "E.g.: 'Ear' in 'FreshEar Co' — this word will be colored.",
        "default": "Ear"
      }
    ]
  },
  {
    "name": "Tracking & Analytics",
    "settings": [
      {
        "type": "header",
        "content": "Meta Pixel"
      },
      {
        "type": "text",
        "id": "meta_pixel_id",
        "label": "Meta Pixel ID",
        "default": ""
      },
      {
        "type": "text",
        "id": "meta_domain_verification",
        "label": "Meta domain verification code",
        "default": ""
      },
      {
        "type": "header",
        "content": "Microsoft Clarity"
      },
      {
        "type": "text",
        "id": "clarity_id",
        "label": "Microsoft Clarity ID",
        "default": ""
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "range",
        "id": "container_max_width",
        "label": "Max content width",
        "min": 1200,
        "max": 1600,
        "step": 50,
        "unit": "px",
        "default": 1400
      },
      {
        "type": "range",
        "id": "border_radius",
        "label": "Default border radius",
        "min": 0,
        "max": 16,
        "step": 1,
        "unit": "px",
        "default": 8
      }
    ]
  }
]
