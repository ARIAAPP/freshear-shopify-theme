{%- assign _sn = 'FreshEar Co' -%}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="{{ settings.color_primary }}">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.logo != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.logo | image_url: width: 32 }}">
    {%- else -%}
      <link rel="icon" type="image/svg+xml" href="{{ 'favicon.svg' | asset_url }}">
    {%- endif -%}

    <title>
      {%- if request.page_type == 'index' -%}
        {{ _sn }} — Ear Cleaning Reinvented
      {%- elsif request.page_type == 'product' -%}
        {{ product.title }} | {{ _sn }}
      {%- elsif request.page_type == 'cart' -%}
        Cart | {{ _sn }}
      {%- else -%}
        {{ page_title }} | {{ _sn }}
      {%- endif -%}
    </title>

    <meta name="description" content="{% if page_description %}{{ page_description | escape }}{% else %}Discover {{ _sn }}, the electric ear irrigator. Gentler and more effective than cotton swabs. Free shipping across the US.{% endif %}">

    {%- comment -%} Open Graph {%- endcomment -%}
    <meta property="og:type" content="website">
    <meta property="og:title" content="{{ _sn }} — Ear Cleaning Reinvented">
    <meta property="og:description" content="Discover {{ _sn }}, the electric ear irrigator. Gentler and more effective than cotton swabs.">
    <meta property="og:url" content="{{ canonical_url }}">
    <meta property="og:site_name" content="{{ _sn }}">

    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ _sn }} — Ear Cleaning Reinvented">
    <meta name="twitter:description" content="Discover {{ _sn }}, the electric ear irrigator.">

    {%- comment -%} Schema.org structured data — Organization + Product (rich snippets Google) {%- endcomment -%}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "{{ _sn }}",
      "url": "{{ shop.url }}",
      "logo": "{% if settings.logo != blank %}{{ settings.logo | image_url: width: 400 }}{% else %}{{ 'hero-poster.jpg' | asset_url }}{% endif %}",
      "email": "support@freshearco.com",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "42 Rue des Mousses",
        "postalCode": "13008",
        "addressLocality": "Marseille",
        "addressCountry": "FR"
      },
      "sameAs": []
    }
    </script>

    {%- if request.page_type == 'index' or request.page_type == 'product' -%}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Product",
      "name": "FreshEar Electric Ear Irrigator",
      "image": [
        "{{ 'sticky-product-thumb.png' | asset_url }}",
        "{{ 'hero-poster.jpg' | asset_url }}"
      ],
      "description": "FreshEar Electric Ear Irrigator: 4 pressure modes, transparent reservoir, hypoallergenic tips. Gentler and more effective than cotton swabs.",
      "brand": {
        "@type": "Brand",
        "name": "FreshEar Co"
      },
      "sku": "FRESHEAR-IRRIGATOR-01",
      "mpn": "FE-IRR-01",
      "offers": {
        "@type": "Offer",
        "url": "{{ shop.url }}",
        "priceCurrency": "USD",
        "price": "49.99",
        "priceValidUntil": "2026-12-31",
        "availability": "https://schema.org/InStock",
        "itemCondition": "https://schema.org/NewCondition",
        "shippingDetails": {
          "@type": "OfferShippingDetails",
          "shippingRate": {
            "@type": "MonetaryAmount",
            "value": "0.00",
            "currency": "USD"
          },
          "shippingDestination": {
            "@type": "DefinedRegion",
            "addressCountry": "US"
          },
          "deliveryTime": {
            "@type": "ShippingDeliveryTime",
            "handlingTime": {
              "@type": "QuantitativeValue",
              "minValue": 1,
              "maxValue": 2,
              "unitCode": "DAY"
            },
            "transitTime": {
              "@type": "QuantitativeValue",
              "minValue": 5,
              "maxValue": 10,
              "unitCode": "DAY"
            }
          }
        },
        "hasMerchantReturnPolicy": {
          "@type": "MerchantReturnPolicy",
          "applicableCountry": "US",
          "returnPolicyCategory": "https://schema.org/MerchantReturnNotPermitted",
          "returnMethod": "https://schema.org/ReturnByMail",
          "returnFees": "https://schema.org/ReturnFeesCustomerResponsibility"
        }
      },
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "4.8",
        "reviewCount": "300",
        "bestRating": "5",
        "worstRating": "1"
      }
    }
    </script>
    {%- endif -%}

    {%- comment -%} Preconnect for performance {%- endcomment -%}
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    {%- comment -%} Facebook preconnect removed — Shopify FB&I app handles pixel loading {%- endcomment -%}

    {%- comment -%} Fonts {%- endcomment -%}
    {%- if settings.font_family == 'poppins' -%}
      <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap">
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" media="print" onload="this.media='all'">
      <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap"></noscript>
    {%- elsif settings.font_family == 'inter' -%}
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" media="print" onload="this.media='all'">
    {%- endif -%}

    {%- comment -%} Design tokens (CSS variables) {%- endcomment -%}
    <style>
      :root {
        --color-primary: {{ settings.color_primary }};
        --color-primary-fg: {{ settings.color_primary_foreground }};
        --color-accent: {{ settings.color_accent }};
        --color-accent-fg: {{ settings.color_accent_foreground }};
        --color-bg: {{ settings.color_background }};
        --color-fg: {{ settings.color_foreground }};
        --color-muted: {{ settings.color_muted }};
        --color-muted-fg: {{ settings.color_muted_foreground }};
        --color-border: {{ settings.color_border }};
        --color-footer-bg: {{ settings.color_footer_bg }};
        --color-footer-fg: {{ settings.color_footer_fg }};
        --container-max: {{ settings.container_max_width }}px;
        --radius: {{ settings.border_radius }}px;
        {%- if settings.font_family == 'poppins' -%}
        --font-sans: 'Poppins', system-ui, -apple-system, sans-serif;
        {%- elsif settings.font_family == 'inter' -%}
        --font-sans: 'Inter', system-ui, -apple-system, sans-serif;
        {%- else -%}
        --font-sans: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
        {%- endif -%}
      }
    </style>

    {{ 'base.css' | asset_url | stylesheet_tag }}

    {%- comment -%}
      Meta Pixel REMOVED — the Shopify Facebook & Instagram app (connected + Optimised)
      handles ALL pixel events (PageView, ViewContent, AddToCart, InitiateCheckout, Purchase)
      both browser-side AND server-side via CAPI. Having a manual pixel here caused:
      - Double-counting of events
      - CAPI deduplication failures
      - EMQ Purchase score of 0.0/10
    {%- endcomment -%}

    {{ content_for_header }}
  </head>

  <body class="template-{{ template | replace: '.', '-' | handle }}">
    {%- comment -%} Meta noscript pixel removed — handled by Shopify FB&I app {%- endcomment -%}

    {% render 'promo-banner' %}

    <a class="skip-link" href="#MainContent">{{ 'general.accessibility.skip_to_content' | t }}</a>

    {% sections 'header-group' %}

    <main id="MainContent" role="main">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% render 'cart-drawer' %}
    {% render 'social-proof-toast' %}
    {% render 'sticky-bottom-bar' %}
    {% render 'scroll-to-top' %}
    {% render 'exit-intent-popup' %}

    <script>
      window.freshearTheme = {
        shopDomain: {{ shop.permanent_domain | json }},
        shopName: {{ shop.name | json }},
        currency: {{ shop.currency | json }},
        moneyFormat: {{ shop.money_format | json }},
        cartUrl: {{ routes.cart_url | json }}
      };
      // Search Pixel event for retargeting
      (function() {
        const params = new URLSearchParams(window.location.search);
        const q = params.get('q');
        if (q && window.fbq) {
          window.fbq('track', 'Search', { search_string: q });
        }
      })();
    </script>
    {{ 'global.js' | asset_url | script_tag }}
    {{ 'cart.js' | asset_url | script_tag }}
  </body>
</html>
